http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "nvim",
    build_file_content = """
exports_files(["bin/nvim"], visibility =["//visibility:public"])
""",
    sha256 = "012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628",
    strip_prefix = "nvim-linux-x86_64",
    urls = [
        "https://github.com/neovim/neovim/releases/download/stable/nvim-linux-x86_64.tar.gz",
    ],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(
    name = "rules_bazel_integration_test",
    version = "0.37.1",
    dev_dependency = True,
)

bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.8")

uv_bin = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv_bin", dev_dependency = True)
uv_bin.toolchain(version = "0.11.21")
use_repo(uv_bin, "uv")
